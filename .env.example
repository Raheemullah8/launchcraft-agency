# ==========================================
# POSTGRESQL DATABASE CONFIGURATION (Template)
# ==========================================

# Replace with your actual Neon or PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Individual credentials (optional reference)
PGHOST="ep-your-host.us-east-2.aws.neon.tech"
PGPORT="5432"
PGUSER="neondb_owner"
PGPASSWORD="your_password_here"
PGDATABASE="neondb"

# Node Environment
NODE_ENV="development"

# ==========================================
# ADMIN AUTHENTICATION
# ==========================================
ADMIN_EMAIL="admin@launchcraft.agency"
ADMIN_PASSWORD="your_secure_password"
ADMIN_NAME="LaunchCraft Admin"
ADMIN_SECRET_KEY="your_jwt_secret_key"
