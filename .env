# ==========================================
# LOCAL POSTGRESQL DATABASE CONFIGURATION
# ==========================================

# Standard PostgreSQL connection URL (Prisma, Drizzle, Supabase, Neon)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]?schema=public
DATABASE_URL="postgresql://postgres:123@localhost:5432/launchcraft?schema=public"

# Individual PostgreSQL connection credentials (for 'pg' library / node-postgres)
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="123"
PGDATABASE="launchcraft"

# Node Environment
NODE_ENV="development"

# ==========================================
# ADMIN AUTHENTICATION
# ==========================================
ADMIN_EMAIL="admin@launchcraft.agency"
ADMIN_PASSWORD="123"
ADMIN_NAME="LaunchCraft Admin"
ADMIN_SECRET_KEY="launchcraft_super_secret_jwt_key_2026"
